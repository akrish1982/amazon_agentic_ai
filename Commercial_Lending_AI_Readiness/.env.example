ANTHROPIC_API_KEY=sk-ant-...
AWS_REGION=us-east-1
AWS_PROFILE=default
S3_BUCKET=lending-ai-docs
GLUE_DATABASE=lending_catalog

# Set to true to use real AWS services instead of local mocks
USE_BEDROCK_KB=false
USE_BEDROCK_EMBEDDINGS=false
USE_REAL_S3=false
USE_REAL_GLUE=false

# Local paths (used when USE_REAL_* flags are false)
LOCAL_S3_ROOT=data/local_s3
LOCAL_DB_PATH=data/lending_ai.db
